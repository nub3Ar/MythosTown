# Required for live minds. Leave unset to run the town offline with scripted minds.
ANTHROPIC_API_KEY=

# The model every townsperson runs on. claude-mythos-5-1 is gated to Project Glasswing
# organisations; claude-fable-5-1 is the same underlying model, generally available.
MYTHOSTOWN_MODEL=claude-mythos-5-1

# Reasoning depth for routine ticks: low | medium | high | xhigh | max
MYTHOSTOWN_EFFORT=low

# Reasoning depth for reflections and daily plans.
MYTHOSTOWN_DEEP_EFFORT=high

# Force scripted minds even when a key is present (true/false).
MYTHOSTOWN_OFFLINE=false

# Hard ceiling on live model calls per simulated day. The engine stops calling and
# falls back to scripted minds for the rest of the day when it is reached.
MYTHOSTOWN_DAILY_CALL_BUDGET=600

# Observer server port.
MYTHOSTOWN_PORT=4321

# Where the journal and snapshots are written.
MYTHOSTOWN_VAR_DIR=var
