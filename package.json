{
  "name": "mythostown",
  "version": "0.1.0",
  "description": "A living town of AI townsfolk, every one of them running on Claude Mythos. Personalities, memory, routines, gossip, grudges.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "mythostown": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "town": "tsx src/cli.ts",
    "run": "tsx src/cli.ts run",
    "day": "tsx src/cli.ts run --ticks 144",
    "dev": "tsx watch src/cli.ts run --offline --speed 250",
    "serve": "tsx src/cli.ts serve",
    "npcs": "tsx src/cli.ts npcs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-town.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nub3Ar/MythosTown.git"
  },
  "homepage": "https://github.com/nub3Ar/MythosTown#readme",
  "bugs": {
    "url": "https://github.com/nub3Ar/MythosTown/issues"
  }
}
